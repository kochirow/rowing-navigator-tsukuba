android/key.properties
/android/**/*.jks
/android/**/*.keystore
ios/Flutter/Secrets.xcconfig
node_modules/
firebase-debug.log

# Local obstacle coordinate plotter artifacts (never commit secrets or changesets)
tool/obstacle-plotter/node_modules/
tool/obstacle-plotter/dist/
tool/obstacle-plotter/.env
tool/obstacle-plotter/.env.local
tool/obstacle-plotter/changeset/
assets/data/.backup/
*.p8

