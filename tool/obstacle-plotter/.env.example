# Apple Developer の Membership にある10文字のTeam ID
APPLE_TEAM_ID=
# Maps用秘密鍵の10文字のKey ID
APPLE_KEY_ID=
# Maps ID（例: maps.jp.example.rowingnavigator）
APPLE_MAPS_ID=
# リポジトリ外に置いた.p8秘密鍵だけを指定する
APPLE_PRIVATE_KEY_PATH=/Users/your-name/.config/rowing-navigator/mapkit/AuthKey_XXXXXXXXXX.p8
TOKEN_TTL_SECONDS=1800
PORT=5174
# Appleのorigin claim はブラウザのOriginと完全一致させる。
MAPKIT_ORIGIN=http://127.0.0.1:5173
# 空のままならアセットへの直接書き込みは無効（既定・推奨）。
PROFILE_WRITE_PATH=
